<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity6">

    <TextView
        android:id="@+id/labelTransport"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:text="Transport"
        android:textSize="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/textTransport"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        tools:text="WiFi"
        android:textSize="20dp"
        app:layout_constraintTop_toTopOf="@+id/labelTransport"
        app:layout_constraintStart_toEndOf="@+id/labelTransport"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <TextView
        android:id="@+id/labelAddress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="IPアドレス"
        android:textSize="20dp"
        app:layout_constraintTop_toBottomOf="@+id/labelTransport"
        app:layout_constraintStart_toEndOf="@+id/labelTransport"/>

    <TextView
        android:id="@+id/textAddress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        tools:text="192.100.100.100"
        android:textSize="20dp"
        app:layout_constraintTop_toBottomOf="@+id/labelAddress"
        app:layout_constraintStart_toStartOf="@+id/labelAddress"
        />


</androidx.constraintlayout.widget.ConstraintLayout>